# Amber Stash 生產環境變數範本（Phase 4）
# 複製成 .env.prod 放在 VPS 上（不要 commit）。docker-compose.prod.yml 會讀它。

# ─── Caddy ───
# 你的網域（DNS A record 要指向這台 VPS）。本機測試可設 :80
AMBER_DOMAIN=amberstash.example.com

# ─── AI proxy（server/proxy 讀這些） ───
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_VERSION=2023-06-01
# CORS：設成你的網域（就是 AMBER_DOMAIN 的 https 形式），不要留 *
CORS_ORIGINS=https://amberstash.example.com
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=30
PORT=8787
