# Amber Stash 生產 reverse proxy（Phase 4）
#
# - 自動 HTTPS（Let's Encrypt）—— 需要真實網域 + 公開 IP + DNS A record 指過來。
# - /api/*  → AI proxy 容器（server/proxy）
# - 其餘    → 靜態 web PWA（dist/），SPA fallback 到 index.html
#
# 網域由 env 注入：部署時設 AMBER_DOMAIN=amberstash.example.com
# 本機 routing 煙霧測試：用 docker-compose.prod.yml 內的 override（AMBER_DOMAIN=:80）。

{$AMBER_DOMAIN} {
	encode gzip zstd

	# AI proxy —— 先比對 /api/*，轉發到 proxy 容器
	handle /api/* {
		reverse_proxy proxy:8787
	}

	# 靜態 web PWA + SPA fallback
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	# manifest 要正確的 content-type（部分瀏覽器挑剔）
	@manifest path /manifest.json
	header @manifest Content-Type application/manifest+json

	header {
		# 基本安全 header（beta 等級）
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
