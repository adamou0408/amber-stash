# Amber Stash 環境變數範本
# 複製這份成 `.env` 後填入真實值。`.env` 已在 .gitignore，不會被 commit。

# ───────────────────────────────────────────────────────────
# AI backend（三層自動回退：proxy → direct → mock）
# 都不設 → 跑 mock 模式（給假資料，dev 流程不卡）
# ───────────────────────────────────────────────────────────

# 自架 proxy URL（生產環境建議走這個 — 隱藏 key + 加 rate limit）
# 對應 server/proxy 的 POST /api/recognize endpoint（見 server/proxy/README.md）
# EXPO_PUBLIC_AMBER_PROXY_URL=https://api.amberstash.com/api/recognize

# 直接打 Anthropic（dev / demo 用 — 注意 EXPO_PUBLIC_* 會 bundle 進 client，
# 不適合長期生產，但 demo / 上架前驗證可用）
# EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-...

# 模型版本（可選，預設 claude-sonnet-4-6）
# EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-4-6

# 免費版每月配額（預設 10）
# EXPO_PUBLIC_FREE_MONTHLY_QUOTA=10
