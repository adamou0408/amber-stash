    "@react-navigation/native-stack": "^7.15.1",
    "@types/qrcode": "^1.5.6",
    "expo": "~54.0.33",
    "expo-camera": "^55.0.18",
    "expo-constants": "^55.0.16",
    "expo-image-picker": "^55.0.20",
    "expo-print": "^55.0.15",
    "expo-sharing": "^55.0.19",
    "expo-status-bar": "~3.0.9",
    "opentype.js": "^2.0.0",
    "qrcode": "^1.5.4",
    "qrcode-svg": "^1.1.0",
    "react": "19.1.0",
