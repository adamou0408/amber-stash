# Amber Stash AI proxy — server-side 設定（不要 commit 真實值）
# 部署時複製成 .env 或用容器 secrets 注入。

# 必填：Anthropic API key（只活在 server 端，永不進 client bundle）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 選填（預設值如下）
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01

# CORS：允許的前端來源，逗號分隔。prod 請設成你的網域，不要留 *
CORS_ORIGINS=https://amberstash.example.com

# rate limit（濫用防護，非 per-user 配額）
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=30

PORT=8787
