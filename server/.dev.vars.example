# Local dev secrets for `wrangler dev`. Copy this file to `.dev.vars` and fill in.
# `.dev.vars` is git-ignored. For production, use `wrangler secret put NAME`.

# Anthropic API key. The proxy injects this server-side so it never reaches the
# client bundle. Get one from https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Stripe webhook signing secret. From Stripe Dashboard → Developers → Webhooks
# → your endpoint → "Signing secret". For local dev with `stripe listen`,
# `stripe listen` prints a `whsec_...` value — paste that here.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
